{
  "openapi": "3.1.0",
  "info": {
    "title": "EVOLVE paid-entitlement API CONTRACT ONLY",
    "version": "m01-draft-0.1.0",
    "description": "No live server is deployed. All routes MUST return 503 / PAYMENT_BACKEND_NOT_READY until M03/M04 implements authenticated server and receipt validation. Browser-side success is never payment proof."
  },
  "servers": [
    {
      "url": "https://api.evolve.invalid",
      "description": "RESERVED .invalid documentation-only placeholder, not a server"
    }
  ],
  "x-m01-environment": "CONTRACT_ONLY",
  "x-merchant-connected": false,
  "x-revenue-enabled": false,
  "security": [
    {
      "userAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "userAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque server-verified access token"
      },
      "providerWebhookProof": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Provider-Signature",
        "description": "Provider-specific signature plus server secret, timestamp/replay check; NOT trusted without cryptographic verification"
      }
    },
    "schemas": {
      "CheckoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "idempotencyKey"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "description": "User-scoped unique operation key; not proof of payment"
          }
        }
      },
      "CheckoutPending": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "status",
          "checkoutUrl"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "const": "PROVIDER_PENDING"
          },
          "checkoutUrl": {
            "type": "string",
            "format": "uri",
            "description": "Backend-generated allow-listed HTTPS provider URL. Must NOT be chosen by client."
          }
        }
      },
      "AccountWallet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "premiumCrystalBalance",
          "refundableDebt",
          "currency",
          "serverUpdatedAt"
        ],
        "properties": {
          "premiumCrystalBalance": {
            "type": "integer",
            "minimum": 0
          },
          "refundableDebt": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "mutation_crystal"
          },
          "serverUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EntitlementResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entitlements",
          "serverUpdatedAt"
        ],
        "properties": {
          "entitlements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sku",
                "entitlementId",
                "status"
              ],
              "properties": {
                "sku": {
                  "type": "string"
                },
                "entitlementId": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "active",
                    "revoked",
                    "expired"
                  ]
                }
              }
            }
          },
          "serverUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RestoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "idempotencyKey"
        ],
        "properties": {
          "provider": {
            "enum": [
              "web",
              "google_play",
              "app_store"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "receiptReference": {
            "type": "string",
            "description": "Must be re-verified by the correct provider, never accepted as a signed fact"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/me/wallet": {
      "get": {
        "operationId": "getWallet",
        "description": "SERVER-LEDGER only; never read localStorage DNA as paid balance",
        "security": [
          {
            "userAuth": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "responses": {
          "200": {
            "description": "Authenticated server balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountWallet"
                }
              }
            }
          },
          "503": {
            "description": "Disabled until M03"
          }
        }
      }
    },
    "/v1/me/entitlements": {
      "get": {
        "operationId": "getEntitlements",
        "description": "Account-scoped paid rights and revoked states",
        "security": [
          {
            "userAuth": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "responses": {
          "200": {
            "description": "User rights from server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementResult"
                }
              }
            }
          },
          "503": {
            "description": "Disabled until M03"
          }
        }
      }
    },
    "/v1/checkout/sessions": {
      "post": {
        "operationId": "createCheckoutSession",
        "security": [
          {
            "userAuth": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "description": "Server must price SKU from provider catalog, validate session/user/stock and bind provider order ID. No premium credits from success URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Server-side pending checkout ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutPending"
                }
              }
            }
          },
          "400": {
            "description": "SKU not available"
          },
          "401": {
            "description": "Not authenticated"
          },
          "409": {
            "description": "Duplicate/conflicting idempotency key"
          },
          "503": {
            "description": "M01-M03 no active payments"
          }
        }
      }
    },
    "/v1/webhooks/{provider}": {
      "post": {
        "operationId": "providerPaymentWebhook",
        "security": [
          {
            "providerWebhookProof": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "description": "M04: validate provider-specific signature, timestamp, provider payment status, order/account SKU from server, immutable transaction ID; SQL atomic grant with unique providerTxId+eventId. No client-controlled amount or entitlements.",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "google_play",
                "app_store"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Verified webhook processed or idempotent replay"
          },
          "401": {
            "description": "Invalid provider proof"
          },
          "503": {
            "description": "No live provider configured"
          }
        }
      }
    },
    "/v1/purchases/restore": {
      "post": {
        "operationId": "restorePurchases",
        "security": [
          {
            "userAuth": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "description": "Never grants based solely on user-provided receipt; re-query provider and reconcile original grant/refund.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Restore reconciliation started"
          },
          "503": {
            "description": "Not active"
          }
        }
      }
    },
    "/v1/ads/rewards/confirm": {
      "post": {
        "operationId": "confirmRewardedAd",
        "security": [
          {
            "providerWebhookProof": []
          }
        ],
        "x-m01-availability": "SPEC_ONLY",
        "description": "Only after publisher approval and provider's server-side verification; unique claim, user, reward slot and daily cap. Never trust browser watched=true.",
        "responses": {
          "204": {
            "description": "Verified unique SSV grant"
          },
          "503": {
            "description": "Ads not approved"
          }
        }
      }
    }
  },
  "x-production-hard-gates": [
    "merchant_account_connected",
    "server_signing_secrets_outside_repo",
    "account_auth_verified",
    "provider_server_receipt_or_signed_webhook_verified",
    "atomic_ledger_and_refunds_deployed",
    "privacy_terms_support_and_platform_policy_validated"
  ]
}
