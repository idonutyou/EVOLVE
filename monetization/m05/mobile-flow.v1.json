    },
    {
      "id": "LEGACY",
      "viewport": "393x852",
      "assertion": "original DNA stages equipment and paid ledger unchanged"
    }
  ],
  "freeze": {
    "milestone": "M05_STEP_1_3_30_PERCENT",
    "design_ready_for_step_2": true,
    "required_files": [
      "monetization/m05/store-inventory-ux.v1.json",
      "monetization/m05/product-detail-states.v1.json",
      "monetization/m05/mobile-flow.v1.json",
      "docs/monetization/M05_030_MOBILE_UX_FREEZE_KO.md"
    ],
    "next_40_percent": "Implement dev-only mobile shop and collection section navigation and product detail UI in an isolated module, preserve M04 runtime",
    "new_images_required_for_next_40_percent": false,
    "do_not_merge_main_until_regression": true,
    "note": "A data contract is not live-browser visual verification; visual behavior must be tested after implementation"
  }
}
