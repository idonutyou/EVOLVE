      "do_not_reset_automatically": true
    }
  },
  "confirmation": {
    "heading": "모의 구매 확인",
    "show_sku_and_reward": true,
    "show_balance_before_after_for_redemption": true,
    "balance_after_formula": "snapshot.testCrystals - 120",
    "explicit_buttons": [
      "취소",
      "확인"
    ],
    "initial_focus": "취소",
    "escape": "CANCEL",
    "outside_click": "CANCEL_OR_NOOP",
    "close_on_processing": false,
    "never_recreate_idempotency_key_on_retry": true,
    "no_real_money_disclaimer": "DEV MOCK · 실제 결제 없음"
  },
  "accessibility": {
    "tap_target_min_px": 44,
    "live_message_role": "status",
    "failure_message_role": "alert",
    "can_wrap_long_korean": true,
    "viewport_sizes": [
      [
        320,
        568
      ],
      [
        393,
        852
      ]
    ],
    "focus_restore": true,
    "aria_disabled_for_locked": true,
    "scroll_restored_after_detail": true
  },
  "constraints": {
    "keep_original_nav_tabs": 5,
    "original_images_unchanged": true,
    "gameplay_stats_unchanged": true,
    "never_write_legacy_save": true,
    "live_prices_null": true,
    "checkout_disabled": true,
    "season_disabled": true,
    "physical_device_tested": false
  },
  "next_30_percent": "mobile touch/focus/scroll state chart and accessibility final UX spec, no new imagery"
