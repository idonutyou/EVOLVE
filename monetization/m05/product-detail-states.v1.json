  "cosmetic_collection": [
    {
      "entitlement": "dev_core_theme_01",
      "source_sku": "appearance_unlock_01",
      "title": "공명 코어",
      "unlock": "MOCK_PURCHASE",
      "test_price": null,
      "states": {
        "unowned": "상품에서 모의 획득",
        "owned": "장착",
        "equipped": "해제"
      },
      "preview": "EXISTING_CHARACTER_CACHED_LIGHT",
      "equip_only_if_owned": true
    },
    {
      "entitlement": "dev_core_theme_02",
      "source_sku": null,
      "title": "심홍 코어",
      "unlock": "TEST_CRYSTAL_REDEMPTION",
      "test_price": 120,
      "states": {
        "unowned_affordable": "TEST 결정 120개로 해금",
        "unowned_insufficient": "결정 부족 · 120개 필요",
        "owned": "장착",
        "equipped": "해제"
      },
      "preview": "EXISTING_CHARACTER_CACHED_LIGHT",
      "equip_only_if_owned": true
    }
  ],
  "action_matrix": [
    {
      "id": "DEV_MODE_OFF",
      "when": "query/host developer gate false",
      "button": "HIDDEN",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "NOT_AT_HOME",
      "when": "player is in combat or leaving home",
      "button": "DISABLED",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "STORAGE_UNREADABLE",
      "when": "mock storage inaccessible or corrupt",
      "button": "DISABLED",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "ACTION_PROCESSING",
      "when": "purchase or redemption in progress",
      "button": "DISABLED",
      "enabled": false,
      "mutation": "NO_CONCURRENT_REQUEST"
    },
    {
      "id": "CONFIRM_PENDING",
      "when": "confirmation is open",
      "button": "CONFIRM_OR_CANCEL_ONLY",
      "enabled": false,
      "mutation": "ONLY_AFTER_CONFIRM"
    },
    {
      "id": "LOCKED_SEASON",
      "when": "catalog.ready=false",
      "button": "준비 중",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "ONCE_OWNED",
      "when": "starter or appearance already granted",
      "button": "보유 중 또는 컬렉션 이동",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "CORE_EQUIPPED",
      "when": "owned theme equals equipped.core",
      "button": "해제",
      "enabled": true,
      "mutation": "MOCK_CORE_ONLY"
    },
    {
      "id": "CORE_OWNED",
      "when": "owned theme not equipped",
      "button": "장착",
      "enabled": true,
      "mutation": "MOCK_CORE_ONLY"
    },
    {
      "id": "REDEEM_INSUFFICIENT",
      "when": "unowned crimson core and balance <120",
      "button": "결정 부족",
      "enabled": false,
      "mutation": "NONE"
    },
    {
      "id": "REDEEM_READY",
      "when": "unowned crimson core and balance >=120",
      "button": "TEST 결정 120개로 해금",
      "enabled": true,
      "mutation": "CONFIRM_THEN_DEBIT_120"
    },
    {
      "id": "REPEATABLE_AVAILABLE",
      "when": "small or mid test pack ready",
      "button": "모의 획득",
      "enabled": true,
      "mutation": "CONFIRM_THEN_GRANT_TEST_ONLY"
    }
  ],
  "transaction_states": [
    {
      "id": "IDLE",
      "next": [
        "DETAIL_OPEN",
        "CONFIRM_PENDING"
      ],
      "writes": false
    },
    {
      "id": "DETAIL_OPEN",
      "next": [
        "IDLE",
        "CONFIRM_PENDING"
      ],
      "writes": false
    },
    {
      "id": "CONFIRM_PENDING",
      "next": [
        "CANCELLED",
        "PROCESSING"
      ],
      "writes": false
    },
    {
      "id": "CANCELLED",
      "next": [
        "DETAIL_OPEN",
        "IDLE"
      ],
      "writes": false,
      "require_same_storage_bytes": true
    },
    {
      "id": "PROCESSING",
      "next": [
        "SUCCESS",
        "FAILURE"
      ],
      "writes": "ONE_IDEMPOTENT_REQUEST"
    },
    {
      "id": "SUCCESS",
      "next": [
        "DETAIL_OPEN",
        "IDLE"
      ],
      "writes": "MOCK_STORE_ONLY",
      "refresh_snapshot": true
    },
    {
      "id": "FAILURE",
      "next": [
        "DETAIL_OPEN",
        "IDLE"
      ],
      "writes": false,
      "retain_saved_bytes_when_storage_error": true
    }
  ],
  "error_copy": {
    "MOCK_ALREADY_OWNED": "이미 획득한 테스트 상품이야. 코어는 컬렉션에서 장착할 수 있어.",
    "MOCK_CONTENT_NOT_READY": "아직 보상이 준비되지 않았어. 현재는 구매할 수 없어.",
    "MOCK_INSUFFICIENT_TEST_CRYSTALS": "TEST 결정이 부족해. 부족한 수량을 확인해 줘.",
    "INVALID_MOCK_STORAGE": "테스트 저장 데이터가 손상되어 변경을 차단했어. 기존 데이터를 자동 삭제하지 않아.",
    "MOCK_STORAGE_UNAVAILABLE": "테스트 저장 공간을 읽을 수 없어. 브라우저 설정을 확인해 줘.",
    "MOCK_STORAGE_WRITE_FAILED": "테스트 구매 기록을 저장하지 못했어. 지급이나 차감은 완료되지 않았어.",
    "MOCK_ENTITLEMENT_NOT_OWNED": "보유하지 않은 코어는 장착할 수 없어.",
    "MOCK_IDEMPOTENCY_CONFLICT": "같은 요청 번호가 다른 상품에 사용되어 지급을 중단했어.",
    "MOCK_RECEIPT_LIMIT": "테스트 기록 한도에 도달했어. 기존 게임 저장은 유지돼.",
    "MOCK_BALANCE_OVERFLOW": "테스트 결정 최대 잔고를 초과해. 지급하지 않았어.",
    "INVALID_MOCK_REQUEST_ID": "요청을 확인할 수 없어. 다시 시도해 줘.",
    "UNKNOWN_MOCK_SKU": "존재하지 않는 상품이야. 지급을 중단했어.",
    "UNKNOWN_MOCK_REDEMPTION": "해금 대상이 확인되지 않아. TEST 결정은 사용되지 않았어."
  },
  "empty_states": {
    "no_cosmetics_owned": {
      "title": "보유 중인 코어가 없어",
      "action": "상점에서 공명 코어를 모의 획득하거나 TEST 결정을 모아 심홍 코어 해금",
      "show_owned_false": true
