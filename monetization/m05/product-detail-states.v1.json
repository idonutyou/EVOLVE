{
  "schema": "evolve.m05.product-detail-state.v1",
  "stage": "M05",
  "percent": 20,
  "step": "1/3",
  "status": "DESIGN_CONTRACT_ONLY",
  "extends": "monetization/m05/store-inventory-ux.v1.json",
  "implement_in_game": false,
  "gates": {
    "mock_only": true,
    "route_query": "evolveMockShop=1",
    "host_allowlist": [
      "idonutyou.github.io",
      "localhost",
      "127.0.0.1"
    ],
    "only_at_home": true,
    "actual_checkout_enabled": false,
    "real_price": null,
    "owner_key": "EVOLVE_DEV_MOCK_STORE_V1",
    "legacy_prefix": "EVOLVE_V575_TEST_",
    "no_image_generation": true,
    "storage_on_cancel": "UNCHANGED_BYTES",
    "storage_on_read_error": "FAIL_CLOSED",
    "no_fallback_paid_wallet": true
  },
  "detail_template": {
    "primary_order": [
      "title",
      "existing_character_preview_if_available",
      "actual_dev_reward",
      "balance_or_owned_state",
      "eligibility_reason",
      "explicit_confirmation_button",
      "mock_only_notice"
    ],
    "only_show_dev_currency": true,
    "missing_preview": "기존 캐릭터 이미지로 표시, 구매 동작과 무관",
    "back_from_detail": "retain current section and list scroll",
    "return_from_confirm": "same product detail, same selected SKU",
    "no_auto_transaction": true
  },
