    "published_build": "9ab09b21eb95876b7977a0aaef34ac51c931c3565fcc8a9e45209812bdd290d6",
    "m04_ui": "web/mock-premium-ui-v616.js",
    "m04_store": "web/mock-premium-v615.js",
    "existing_home": "dist/index.html"
  },
  "release": {
    "target": [
      "google_play",
      "apple_app_store"
    ],
    "web_role": "DEVELOPMENT_ONLY",
    "actual_checkout_enabled": false,
    "live_prices": false,
    "billing_integration": "M08_FINAL_GAME_ONLY",
    "current_design_not_deployed": true
  },
  "preservation": {
    "existing_five_home_tabs": [
      "homeLabTab",
      "homeSpecimenTab",
      "homeBattleTabV522",
      "memoryBtn",
      "codexBtn"
    ],
    "existing_organism_inventory": "partsGridV523",
    "existing_part_sort": "partsSortV523",
    "mock_key": "EVOLVE_DEV_MOCK_STORE_V1",
    "legacy_prefix": "EVOLVE_V575_TEST_",
    "separate_real_ledger": true,
    "never_migrate_dev_entitlements": true,
    "original_images_untouched": true,
    "combat_stats_unchanged": true,
    "automatic_reload": false
  },
  "entry": {
    "host_allowlist": [
      "idonutyou.github.io",
      "localhost",
      "127.0.0.1"
    ],
    "required_query": "evolveMockShop=1",
    "open_only_when": "EVOLVE_WEB_GUARD.atHome() === true",
    "entry_button": "m04MockTriggerV616",
    "placement": "existing top overlay trigger, not a sixth navigation tab",
    "battle_access": "DENY",
    "close_behavior": "restore focus to last home control; discard pending confirmation without transaction"
  },
  "architecture": {
    "presentation": "single home overlay with sections, no changes to base five navigation tabs",
    "sections": [
      {
        "id": "shop",
        "label": "모의 상점",
        "purpose": "상품 발견과 혜택/가격이 아닌 TEST 지급 설명",
        "default": true
      },
      {
        "id": "collection",
        "label": "코어 컬렉션",
        "purpose": "owned/unowned/equipped 코어와 게임 캐릭터 실제 미리보기"
      },
      {
        "id": "history",
        "label": "테스트 기록",
        "purpose": "TEST 영수증 상태와 안내; no refund claim",
        "availability": "PLANNED_FOR_LATER_STEP"
      }
    ],
    "surfaceOrder": [
      "title_and_mock_only_notice",
      "test_currency_balance",
      "section_selector",
      "selected_section",
      "status_and_error",
      "reset_behind_safe_actions"
    ],
    "existing_equipment_jump": {
      "mode": "close_overlay_then_existing_tab",
      "target": "homeSpecimenTab",
      "description": "do not move or copy saved equipped parts; cosmetic and actual weapon equipment are separate"
    }
  },
  "shop": {
    "group_order": [
      "appearance",
      "starter",
      "test_currency",
      "season_locked"
    ],
    "cards": [
      {
        "sku": "appearance_unlock_01",
        "type": "mock_entitlement",
        "owned_key": "dev_core_theme_01",
        "source": "simulatePurchase",
        "button_before": "모의 구매",
        "button_after": "장착 / 해제",
        "real_price": null,
        "preview": "existing original mutant + cached blue core overlay"
      },
      {
        "sku": "starter_genome_once",
        "type": "mock_one_time",
        "test_crystals_granted": 75,
        "button_before": "모의 획득",
        "button_after": "보유 중",
        "real_price": null,
        "disclaimer": "현재 지급물은 TEST 결정 75개와 DEV 소유 상태뿐; 실제 전투 보너스 없음"
      },
      {
        "sku": "mutation_crystal_small",
        "type": "mock_repeatable",
        "test_crystals_granted": 100,
        "button_before": "모의 획득",
        "real_price": null
      },
      {
        "sku": "mutation_crystal_mid",
        "type": "mock_repeatable",
        "test_crystals_granted": 300,
        "button_before": "모의 획득",
        "real_price": null
      },
      {
        "sku": "season_research_pass_01",
        "type": "locked",
        "ready": false,
        "button_before": "준비 중",
        "purchase_action": null,
        "real_price": null,
        "disclaimer": "실제 보상 및 유효기간 미설계, 판매 금지"
      }
    ],
    "no_false_scarcity": true,
    "no_auto_purchase": true,
    "no_preselected_paid_product": true
  },
  "collection": {
    "slot": "core",
    "items": [
      {
        "entitlement": "dev_core_theme_01",
        "label": "공명 코어",
        "source": "appearance_unlock_01",
        "unlock": "mock_purchase",
        "test_price": null
      },
      {
        "entitlement": "dev_core_theme_02",
        "label": "심홍 코어",
        "source": "test_crystal_redemption",
        "unlock": "redeemCosmetic",
        "test_price": 120
      }
    ],
    "states": [
      "not_owned",
      "owned",
      "equipped",
      "unavailable"
    ],
    "only_owned_can_equip": true,
    "preview_source": "__EVOLVE_DEV_CORE_BRIDGE_V617__.preview",
    "equipment_state_source": "mock_store.snapshot(profile).equipped",
    "no_combat_advantage": true
  },
  "interaction": {
    "flow": [
      "home",
      "open_shop",
      "inspect_detail",
      "confirm_or_cancel",
      "grant_once",
      "show_ownership",
      "collection_equip",
      "return_home"
    ],
    "confirmation_required_for": [
      "simulatePurchase",
      "redeemCosmetic"
    ],
    "pending_request_id_reused_on_retry": true,
    "cancel_must_not_change_bytes": true,
    "failed_storage_never_grants": true,
    "no_in_fight_open": true,
    "read_only_on_corrupt_save": true,
    "reset_requires_two_explicit_taps": true,
    "preserve_legacy_saves": true,
    "external_store_redirects_forbidden": true
  },
  "usability": {
    "mobile_viewports": [
      [
        320,
        568
      ],
      [
        393,
        852
      ]
    ],
    "minimum_touch_target_px": 44,
    "text_scaling": "keep Korean labels legible and allow wrap instead of clipping",
    "safe_area": true,
    "modal_internal_scroll": true,
    "focus_first_element_on_open": true,
    "restore_focus_on_close": true,
    "esc_cancels_pending_before_closing": true,
    "keyboard_focus_trap": true,
    "accessible_status_role": true,
    "distinguish_balance": "DEV TEST 결정, never paid currency",
    "no_auto_reload": true
  },
  "future_milestones": {
    "20": "product details, ownership-state mapping and error copy as data contract",
    "30": "interaction specification and design-gate tests",
    "40-70": "implement UI in feature branch, local/mobile QA, preserve M04 ledger",
    "80-100": "regression, safe main deployment, real Pages URL tests and checkpoints"
  },
  "acceptance_10": [
    "audit actual five home tab ids, existing organism inventory and M04 overlay",
