{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idonutyou.github.io/EVOLVE/monetization/schema/catalog-draft-m01.v1",
  "title": "EVOLVE M01 draft-only SKU catalog, not live checkout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "display_currency",
    "price_source",
    "checkout_enabled",
    "client_grants_enabled",
    "merchant_connected",
    "backend_ledger_connected",
    "note_ko",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": "m01.v1"
    },
    "environment": {
      "const": "DRAFT_ONLY"
    },
    "display_currency": {
      "const": "KRW"
    },
    "price_source": {
      "const": "VERIFIED_PROVIDER_CATALOG_ONLY"
    },
    "checkout_enabled": {
      "const": false
    },
    "client_grants_enabled": {
      "const": false
    },
    "merchant_connected": {
      "const": false
    },
    "backend_ledger_connected": {
      "const": false
    },
    "note_ko": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "category",
          "purchase_type",
          "status",
          "price_minor",
          "premium_crystal_units",
          "entitlement_id",
          "repeat_limit",
          "title_ko",
          "content_state"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,64}$"
          },
          "category": {
            "enum": [
              "starter",
              "currency_pack",
              "cosmetic",
              "season_pass"
            ]
          },
          "purchase_type": {
            "enum": [
              "account_once",
              "consumable",
              "non_consumable",
              "seasonal_non_consumable"
            ]
          },
          "status": {
            "const": "draft_disabled"
          },
          "price_minor": {
            "type": "null"
          },
          "premium_crystal_units": {
            "type": "null"
          },
          "entitlement_id": {
            "type": "null"
          },
          "repeat_limit": {
            "type": [
              "null",
              "integer"
            ],
            "minimum": 1,
            "maximum": 1
          },
          "title_ko": {
            "type": "string",
            "minLength": 1
          },
          "content_state": {
            "const": "not_finalized"
          }
        }
      }
    }
  }
}
