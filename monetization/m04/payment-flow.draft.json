  "order_contract": {
    "server_generated_id": true,
    "server_verified_account_id": true,
    "app_build_identity_verified": true,
    "authoritative_fields": [
      "account_id",
      "internal_sku",
      "platform",
      "platform_product_id",
      "store_transaction_id_or_purchase_token",
      "store_verified_status",
      "store_environment",
      "entitlement_or_crystal_units"
    ],
    "fields_never_authoritative_from_client": [
      "account_id",
      "amount",
      "price_minor",
      "currency",
      "premium_crystal_units",
      "entitlement_id",
      "paid",
      "payment_status",
      "grant_allowed",
      "platform_product_id",
      "receipt_verified"
    ],
    "uniqueness": [
      "platform:store_transaction_id_or_purchase_token",
      "account_id:idempotency_key",
      "platform:notification_id"
    ],
    "hash_request_payload": true,
    "store_server_verification_required": true,
    "callback_success_never_confirms_payment": true
  },
  "providers": {
    "google_play_billing": {
      "native_sdk": "Google Play Billing Library",
      "purchase_proof": "purchaseToken",
      "verification": "Google Play Developer API one-time product purchases:get or subscriptionsv2:get as appropriate",
      "paid_status": "PURCHASED",
      "pending_status": "PENDING",
      "purchase_ack_or_consume": "after verified atomic server grant, acknowledge non-consumables / consume consumables, idempotently",
      "notifications": "Google Play Real-time Developer Notifications + Voided Purchases API; notifications prompt server re-verification",
      "identity_binding": "obfuscatedAccountId derived from verified game account with privacy protections",
      "refund": "Void/Refund verification via developer APIs before source-specific review"
    },
    "apple_storekit_2": {
      "native_sdk": "StoreKit 2",
      "purchase_proof": "signedTransactionInfo JWS or verified transaction identifier",
      "verification": "App Store Server API Get Transaction Info + validated signedTransactionInfo JWS and app identity, environment, productId, revocation",
      "paid_status": "VERIFIED_TRANSACTION",
      "pending_status": "PENDING",
      "completion": "Only after server idempotent entitlement grant; ensure transaction finish() is handled correctly",
      "notifications": "App Store Server Notifications V2 with validated signedPayload JWS",
      "identity_binding": "appAccountToken associated with game account where applicable",
      "refund": "App Store Server API transaction history / signed revocation and V2 notifications, source-specific review",
      "non_expiry": "purchased in-app currency must not expire"
    }
  },
  "states": [
    "DRAFT_DISABLED",
    "ORDER_CREATED",
    "AWAITING_STORE",
    "PENDING_STORE_APPROVAL",
    "STORE_PURCHASE_VERIFIED",
    "FULFILLED",
    "CANCELLED",
    "REFUND_REVIEW",
    "REVERSED",
    "DISPUTED"
  ],
  "transitions_design_only": [
    {
      "from": "DRAFT_DISABLED",
      "to": "ORDER_CREATED",
      "by": "verified-account-and-actual-store-product-approval",
      "enabled": false
    },
    {
      "from": "ORDER_CREATED",
      "to": "AWAITING_STORE",
      "by": "native-sdk-purchase-flow"
    },
    {
      "from": "AWAITING_STORE",
      "to": "PENDING_STORE_APPROVAL",
      "by": "store-pending-notification"
    },
    {
      "from": "AWAITING_STORE",
      "to": "STORE_PURCHASE_VERIFIED",
      "by": "store-api-verified-token-or-transaction"
    },
    {
      "from": "PENDING_STORE_APPROVAL",
      "to": "STORE_PURCHASE_VERIFIED",
      "by": "store-api-verified-token-or-transaction"
    },
    {
      "from": "STORE_PURCHASE_VERIFIED",
      "to": "FULFILLED",
      "by": "server-atomic-ledger-and-entitlement-grant"
    },
    {
      "from": "AWAITING_STORE",
      "to": "CANCELLED",
      "by": "store-cancelled-or-failed"
    },
    {
      "from": "FULFILLED",
      "to": "REFUND_REVIEW",
      "by": "store-verified-refund-or-revocation"
    },
    {
      "from": "REFUND_REVIEW",
      "to": "REVERSED",
      "by": "approved-source-specific-reversal"
    },
    {
      "from": "FULFILLED",
      "to": "DISPUTED",
      "by": "store-verified-dispute"
    }
  ],
  "fulfilment_gates": [
    "authenticated-recoverable-game-account",
    "store-app-identity-package-name-or-bundle-id-match",
    "store-environment-verified-test-vs-production",
    "store-product-id-maps-to-internal-sku",
    "store-reported-product-and-quantity-valid",
    "store-transaction-status-verified-not-pending",
